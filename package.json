{
  "name": "opencode-token-norm",
  "version": "0.11.0",
  "description": "OpenCode plugin for token-budget guardrails: counts budgeted tool calls, injects reminders at thresholds, audits usage automatically, and makes session handoff a single tool call",
  "type": "module",
  "license": "MIT",
  "author": "salitaba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salitaba/opencode-token-norm.git"
  },
  "bugs": {
    "url": "https://github.com/salitaba/opencode-token-norm/issues"
  },
  "homepage": "https://github.com/salitaba/opencode-token-norm#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tokens",
    "cost",
    "context",
    "budget",
    "handoff",
    "session"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-token-norm": "scripts/install-local.mjs"
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --legal-comments=none --outfile=dist/plugin.js && npm run build:claude-hook && npm run build:provenance",
    "build:claude-hook": "esbuild src/hosts/claude/main.ts --bundle --platform=node --format=esm --target=node22 --legal-comments=none --outfile=dist/claude-hook.mjs",
    "build:provenance": "node tools/provenance.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:plugin",
    "test": "vitest run",
    "install:local": "npm run build:plugin && node scripts/install-local.mjs",
    "prepublishOnly": "npm run build && npm run build:plugin"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
